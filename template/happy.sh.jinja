#!/bin/bash
set -ex

echo "=== Syncing dependencies ==="
uv sync --all-extras --all-groups

echo "=== Formatting ==="
uv run ruff format .

echo "=== Tests + Coverage ==="
uv run pytest --cov=src/{{ package_slug }} --cov-report=term-missing --cov-fail-under=100 .

echo "=== Type Checking ==="
{%- if type_checker == 'mypy' %}
uv run mypy src/{{ package_slug }} tests
{%- else %}
uv run ty check src tests
{%- endif %}
{%- if project_type == 'package' %}

echo "=== Docs Build ==="
uv run make -C docs clean html SPHINXOPTS=--fail-on-warning
{%- endif %}

echo "=== All checks passed! ==="
